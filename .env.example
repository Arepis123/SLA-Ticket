APP_NAME=FixWatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://fixwatch.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sla_ticket
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shared secret for public/cron.php, for hosts that cannot run the Laravel
# scheduler from cron. Generate with: php -r "echo bin2hex(random_bytes(24));"
# Leave empty to refuse all HTTP access to that script.
SLA_CRON_TOKEN=

# When clients are emailed a digest of tickets waiting on them (pending their
# reply, or resolved and awaiting confirmation), in SLA_TIMEZONE. Empty disables it.
SLA_REMINDER_TIMES=08:00,14:00

# Timezone your office hours and holidays are written in (Administration →
# Business Hours), e.g. Asia/Kuala_Lumpur. Empty uses the app timezone.
SLA_TIMEZONE=

# Browser push notifications. Generate once with `php artisan webpush:vapid`
# and never change them: existing subscriptions stop working if they do.
# VAPID_SUBJECT is a contact for the push services; empty uses APP_URL.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
